.options-menu {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.scrim--strong {
    background-color: rgba(6, 4, 6, 0.62);
}

.options-panel {
    width: 62%;
    max-width: 1180px;
    padding: 52px 60px 44px 60px;
    align-items: stretch;
    background-color: rgba(12, 8, 10, 0.86);
    border-width: 2px;
    border-color: rgba(150, 112, 74, 0.5);
    border-radius: 18px;
}

.options-title {
    margin-bottom: 30px;
    font-size: 62px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: var(--color-title);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.option-row {
    flex-direction: row;
    align-items: center;
    margin: 12px 0;
    padding: 6px 0;
}

.option-label {
    width: 160px;
    font-size: 30px;
    -unity-font-style: bold;
    color: #ecdfbf;
}

/* Fila sin slider (chuleta de controles): la etiqueta ocupa el hueco y el toggle queda a la derecha. */
.option-label--wide {
    width: auto;
    flex-grow: 1;
}

.option-slider {
    flex-grow: 1;
    min-height: 34px;
    margin: 0 8px;
}

.option-slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(150, 112, 74, 0.4);
    border-radius: 4px;
}

.option-slider .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
    border-width: 0;
    border-radius: 12px;
    background-color: #f4ce84;
}

.option-slider:hover .unity-base-slider__dragger {
    background-color: #ffe6a8;
}

.option-value {
    width: 132px;
    font-size: 24px;
    color: rgba(214, 176, 120, 0.9);
    -unity-text-align: middle-right;
}

.option-mute {
    width: 168px;
    margin-left: 28px;
    font-size: 20px;
}

.option-mute .unity-toggle__label {
    color: #d8c9a6;
    font-size: 20px;
    min-width: auto;
}

.option-mute .unity-toggle__checkmark {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    border-width: 2px;
    border-color: rgba(150, 112, 74, 0.65);
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.5);
}

.option-mute:checked .unity-toggle__checkmark {
    background-color: rgba(122, 26, 34, 0.9);
    border-color: var(--color-btn-border-hover);
    -unity-background-image-tint-color: #ffe6a8;
}

.back-button {
    align-self: center;
    margin-top: 34px;
}

/* Selector de dos flechas (resolución, idioma): ocupa el mismo hueco que slider + valor + silenciar,
   con la misma fuente y colores que el resto de filas. */
.option-selector {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0 8px;
    min-height: 34px;
}

.option-choice {
    flex-grow: 1;
    font-size: 30px;
    -unity-font-style: bold;
    color: #ecdfbf;
    -unity-text-align: middle-center;
}

.option-arrow {
    width: 56px;
    height: 48px;
    margin: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: #f4ce84;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: rgba(150, 112, 74, 0.65);
    border-radius: 6px;
}

.option-arrow:hover,
.option-arrow:focus {
    color: #ffe6a8;
    background-color: rgba(122, 26, 34, 0.9);
    border-color: var(--color-btn-border-hover);
}

/* ---- Pestañas (General / Interfaz) ---- */
.option-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 18px;
}

.option-tab {
    min-width: 260px;
    height: 64px;
    margin: 0 10px;
    padding: 0 24px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgba(236, 223, 191, 0.6);
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 2px;
    border-color: rgba(150, 112, 74, 0.35);
    border-radius: 10px;
}

.option-tab:hover {
    color: #ffe6a8;
    border-color: rgba(150, 112, 74, 0.8);
}

.option-tab--active {
    color: #ffe6a8;
    background-color: rgba(122, 26, 34, 0.85);
    border-color: var(--color-btn-border-hover);
}

/* Las dos páginas comparten alto mínimo: cambiar de pestaña no hace saltar el panel. */
.option-pages {
    min-height: 640px;
}

.option-label--hud {
    width: 330px;
}

.option-row--buttons {
    justify-content: center;
    margin-top: 26px;
}

.option-wide-button {
    width: 470px;
    height: 84px;
    margin: 0 14px;
    font-size: 30px;
}

/* Interfaz tiene más filas que General: algo más juntas para que quepa en el alto de referencia. */
.option-page--compact .option-row {
    margin: 4px 0;
}

.option-page--compact .option-row--buttons {
    margin-top: 18px;
}
