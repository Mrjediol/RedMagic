<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Ui/MainMenu.uss?fileID=7433441132597879392&amp;guid=1bc0f283f5902bb4f8e04c4a5c3d8948&amp;type=3#MainMenu"/>
    <Style src="project://database/Assets/Ui/OptionsMenu.uss?fileID=7433441132597879392&amp;guid=1f45bf5183789224d85ff656bdd830b5&amp;type=3#OptionsMenu"/>
    <ui:VisualElement name="optionsMenu" class="options-menu">
        <ui:VisualElement name="backgroundLayer" picking-mode="Ignore" class="background-layer"/>
        <ui:VisualElement name="scrim" picking-mode="Ignore" class="scrim scrim--strong" style="background-image: url(&quot;project://database/Assets/Art/UI/MainMenu.jpeg?fileID=2800000&amp;guid=9b93da1ad30065640b7ec3dab0744d65&amp;type=3#MainMenu&quot;);"/>
        <ui:VisualElement name="optionsPanel" class="options-panel">
            <ui:Label text="#options.title" class="options-title"/>
            <ui:VisualElement name="tabBar" class="option-tabs">
                <ui:Button name="generalTab" text="#options.tab.general" class="option-tab"/>
                <ui:Button name="interfaceTab" text="#options.tab.interface" class="option-tab"/>
            </ui:VisualElement>
            <ui:VisualElement name="pages" class="option-pages">
                <ui:VisualElement name="generalPage" class="option-page">
                    <ui:VisualElement name="masterRow" class="option-row">
                        <ui:Label text="#options.master" class="option-label"/>
                        <ui:Slider name="masterSlider" low-value="0" high-value="1" class="option-slider"/>
                        <ui:Label name="masterValue" text="100%" class="option-value"/>
                        <ui:Toggle name="masterMute" label="#options.mute" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="musicRow" class="option-row">
                        <ui:Label text="#options.music" class="option-label"/>
                        <ui:Slider name="musicSlider" low-value="0" high-value="1" class="option-slider"/>
                        <ui:Label name="musicValue" text="100%" class="option-value"/>
                        <ui:Toggle name="musicMute" label="#options.mute" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="sfxRow" class="option-row">
                        <ui:Label text="#options.sfx" class="option-label"/>
                        <ui:Slider name="sfxSlider" low-value="0" high-value="1" class="option-slider"/>
                        <ui:Label name="sfxValue" text="100%" class="option-value"/>
                        <ui:Toggle name="sfxMute" label="#options.mute" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="resolutionRow" class="option-row">
                        <ui:Label text="#options.resolution" class="option-label"/>
                        <ui:VisualElement class="option-selector">
                            <ui:Button name="resolutionPrev" text="&lt;" class="option-arrow"/>
                            <ui:Label name="resolutionValue" text="PC · 16:9" class="option-choice"/>
                            <ui:Button name="resolutionNext" text="&gt;" class="option-arrow"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="fpsLimitRow" class="option-row">
                        <ui:Label text="#options.fps_limit" class="option-label"/>
                        <ui:VisualElement class="option-selector">
                            <ui:Button name="fpsLimitPrev" text="&lt;" class="option-arrow"/>
                            <ui:Label name="fpsLimitValue" text="60" class="option-choice"/>
                            <ui:Button name="fpsLimitNext" text="&gt;" class="option-arrow"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="showFpsRow" class="option-row">
                        <ui:Label text="#options.show_fps" class="option-label"/>
                        <ui:Toggle name="showFpsToggle" label="#options.show" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="languageRow" class="option-row">
                        <ui:Label text="#options.language" class="option-label"/>
                        <ui:VisualElement class="option-selector">
                            <ui:Button name="languagePrev" text="&lt;" class="option-arrow"/>
                            <ui:Label name="languageValue" text="Español" class="option-choice"/>
                            <ui:Button name="languageNext" text="&gt;" class="option-arrow"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- TEMPORAL: trucos de prueba (DebugCheats) -->
                    <ui:VisualElement name="godModeRow" class="option-row">
                        <ui:Label text="#options.debug.god_mode" class="option-label option-label--wide"/>
                        <ui:Toggle name="godModeToggle" label="#options.enabled" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="oneHitKillRow" class="option-row">
                        <ui:Label text="#options.debug.one_hit_kill" class="option-label option-label--wide"/>
                        <ui:Toggle name="oneHitKillToggle" label="#options.enabled" class="option-mute"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="interfacePage" class="option-page option-page--compact">
                    <ui:VisualElement name="hurtRow" class="option-row">
                        <ui:Label text="#options.hud.hurt" class="option-label option-label--hud"/>
                        <ui:Slider name="hurtSlider" low-value="0" high-value="1" class="option-slider"/>
                        <ui:Label name="hurtValue" text="60%" class="option-value"/>
                        <ui:Toggle name="hurtToggle" label="#options.enabled" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="healRow" class="option-row">
                        <ui:Label text="#options.hud.heal" class="option-label option-label--hud"/>
                        <ui:Slider name="healSlider" low-value="0" high-value="1" class="option-slider"/>
                        <ui:Label name="healValue" text="50%" class="option-value"/>
                        <ui:Toggle name="healToggle" label="#options.enabled" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="lowHealthRow" class="option-row">
                        <ui:Label text="#options.hud.low_health" class="option-label option-label--hud"/>
                        <ui:Slider name="lowHealthSlider" low-value="0" high-value="1" class="option-slider"/>
                        <ui:Label name="lowHealthValue" text="50%" class="option-value"/>
                        <ui:Toggle name="lowHealthToggle" label="#options.enabled" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="controlsRow" class="option-row">
                        <ui:Label text="#options.controls_legend" class="option-label option-label--wide"/>
                        <ui:Toggle name="controlsToggle" label="#options.show" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="gestureControlsRow" class="option-row">
                        <ui:Label text="#options.touch_gestures" class="option-label option-label--wide"/>
                        <ui:Toggle name="gestureControlsToggle" label="#options.enabled" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="enemyModeRow" class="option-row">
                        <ui:Label text="#options.hud.enemy_health" class="option-label option-label--hud"/>
                        <ui:VisualElement class="option-selector">
                            <ui:Button name="enemyModePrev" text="&lt;" class="option-arrow"/>
                            <ui:Label name="enemyModeValue" text="-" class="option-choice"/>
                            <ui:Button name="enemyModeNext" text="&gt;" class="option-arrow"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="enemyNumbersRow" class="option-row">
                        <ui:Label text="#options.hud.enemy_numbers" class="option-label option-label--wide"/>
                        <ui:Toggle name="enemyNumbersToggle" label="#options.show" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="enemyCooldownsRow" class="option-row">
                        <ui:Label text="#options.hud.enemy_cooldowns" class="option-label option-label--wide"/>
                        <ui:Toggle name="enemyCooldownsToggle" label="#options.show" class="option-mute"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="layoutRow" class="option-row option-row--buttons">
                        <ui:Button name="layoutButton" text="#options.hud.place" class="menu-button option-wide-button"/>
                        <ui:Button name="layoutResetButton" text="#options.hud.reset_layout" class="menu-button option-wide-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="touchLayoutRow" class="option-row option-row--buttons">
                        <ui:Button name="touchLayoutButton" text="#options.touch_place" class="menu-button option-wide-button"/>
                        <ui:Button name="touchLayoutResetButton" text="#options.touch_reset_layout" class="menu-button option-wide-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="backButton" text="#common.back" class="menu-button back-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
