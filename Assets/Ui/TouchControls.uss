.touch-controls {
    flex-grow: 1;
}

.touch-controls-inner {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 72px 72px 72px;
}

.touch-cluster {
    flex-direction: row;
    align-items: flex-end;
}

.touch-cluster--left {
    flex-grow: 1;
    justify-content: flex-start;
}

.touch-cluster--right {
    flex-grow: 1;
    justify-content: flex-end;
}

.touch-button {
    width: 180px;
    height: 180px;
    margin: 0 18px;
    padding: 0;
    font-size: 64px;
    -unity-font-style: bold;
    color: rgba(236, 223, 191, 0.9);
    background-color: rgba(18, 11, 14, 0.45);
    border-width: 3px;
    border-color: rgba(150, 112, 74, 0.5);
    border-radius: 90px;
    -unity-text-align: middle-center;
    transition-duration: 0.08s;
    scale: 1;
}

.touch-button:hover {
    background-color: rgba(18, 11, 14, 0.6);
}

.touch-button:active,
.touch-button--pressed {
    scale: 0.94;
    background-color: rgba(122, 26, 34, 0.75);
    border-color: rgba(244, 206, 132, 0.95);
    color: #fff7e2;
}

.touch-button--jump {
    width: 230px;
    height: 230px;
    font-size: 34px;
    letter-spacing: 2px;
    border-radius: 115px;
    background-color: rgba(60, 16, 22, 0.5);
}

.touch-button--jump:active,
.touch-button--jump.touch-button--pressed {
    background-color: rgba(150, 32, 42, 0.8);
}

.touch-button--down {
    font-size: 26px;
    letter-spacing: 1px;
    background-color: rgba(24, 20, 30, 0.5);
}

.touch-button--down:active,
.touch-button--down.touch-button--pressed {
    background-color: rgba(70, 58, 92, 0.8);
}

.touch-button--attack {
    width: 200px;
    height: 200px;
    font-size: 30px;
    letter-spacing: 2px;
    border-radius: 100px;
    background-color: rgba(68, 40, 12, 0.5);
}

.touch-button--attack:active,
.touch-button--attack.touch-button--pressed {
    background-color: rgba(186, 108, 30, 0.8);
}

.touch-button--dash {
    font-size: 30px;
    letter-spacing: 1px;
    background-color: rgba(16, 30, 38, 0.5);
}

.touch-button--dash:active,
.touch-button--dash.touch-button--pressed {
    background-color: rgba(38, 104, 128, 0.8);
}

.touch-button--fireball {
    width: 200px;
    height: 200px;
    font-size: 30px;
    letter-spacing: 2px;
    border-radius: 100px;
    background-color: rgba(74, 22, 14, 0.5);
}

.touch-button--fireball:active,
.touch-button--fireball.touch-button--pressed {
    background-color: rgba(196, 66, 26, 0.85);
}

.touch-button--parry {
    font-size: 30px;
    letter-spacing: 1px;
    background-color: rgba(22, 40, 14, 0.5);
}

.touch-button--parry:active,
.touch-button--parry.touch-button--pressed {
    background-color: rgba(96, 160, 44, 0.85);
}

.touch-button--interact {
    position: absolute;
    right: 64px;
    bottom: 330px;
    width: 200px;
    height: 200px;
    font-size: 28px;
    letter-spacing: 1px;
    border-radius: 100px;
    background-color: rgba(70, 56, 14, 0.6);
    border-color: rgba(244, 206, 132, 0.8);
}

.touch-button--interact:active,
.touch-button--interact.touch-button--pressed {
    background-color: rgba(196, 150, 40, 0.85);
}

/* ---- Controles por gestos (TouchGestureInput) ---- */

.gesture-layout {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.gesture-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Ancho y alto los pone el código (Inspector ▸ Gestures). */
.gesture-zone {
    position: absolute;
    left: 0;
    bottom: 0;
    background-color: rgba(236, 223, 191, 0.04);
    border-top-width: 2px;
    border-right-width: 2px;
    border-color: rgba(236, 223, 191, 0.12);
    border-top-right-radius: 48px;
}

/* Tamaño, radio y posición los pone el código. */
.gesture-stick {
    position: absolute;
    display: none;
    background-color: rgba(18, 11, 14, 0.25);
    border-width: 3px;
    border-color: rgba(150, 112, 74, 0.45);
}

.gesture-knob {
    position: absolute;
    display: none;
    width: 110px;
    height: 110px;
    border-radius: 55px;
    background-color: rgba(236, 223, 191, 0.25);
    border-width: 3px;
    border-color: rgba(236, 223, 191, 0.5);
}

.gesture-knob--active {
    background-color: rgba(122, 26, 34, 0.6);
    border-color: rgba(244, 206, 132, 0.9);
}

.gesture-aim {
    position: absolute;
    display: none;
    width: 90px;
    height: 90px;
    border-radius: 45px;
    border-width: 4px;
    border-color: rgba(244, 206, 132, 0.7);
}

/* Sitio de fábrica de cada botón de gestos (abajo a la derecha: dash · ataque · salto, parry encima del salto
   y USAR encima del ataque). Lo que el jugador recoloque lo pone el código en left/top. */
.gesture-button {
    position: absolute;
    margin: 0;
}

.gesture-jump {
    right: 66px;
    bottom: 56px;
}

.gesture-attack {
    right: 332px;
    bottom: 56px;
}

.gesture-dash {
    right: 568px;
    bottom: 56px;
}

.gesture-parry {
    right: 91px;
    bottom: 322px;
}

.touch-button--interact.touch-button--interact-gesture {
    margin: 0;
    right: 332px;
    bottom: 322px;
}

/* Con 8 botones el margen por defecto deja los clusters muy juntos. */
.touch-controls-inner {
    padding: 0 48px 56px 48px;
}
