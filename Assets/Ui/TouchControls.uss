.touch-controls {
    flex-grow: 1;
}

.touch-controls-inner {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 72px 72px 72px;
}

.touch-cluster {
    flex-direction: row;
    align-items: flex-end;
}

.touch-cluster--left {
    flex-grow: 1;
    justify-content: flex-start;
}

.touch-cluster--right {
    flex-grow: 1;
    justify-content: flex-end;
}

.touch-button {
    width: 180px;
    height: 180px;
    margin: 0 18px;
    padding: 0;
    font-size: 64px;
    -unity-font-style: bold;
    color: rgba(236, 223, 191, 0.9);
    background-color: rgba(18, 11, 14, 0.45);
    border-width: 3px;
    border-color: rgba(150, 112, 74, 0.5);
    border-radius: 90px;
    -unity-text-align: middle-center;
    transition-duration: 0.08s;
    scale: 1;
}

.touch-button:hover {
    background-color: rgba(18, 11, 14, 0.6);
}

.touch-button:active {
    scale: 0.94;
    background-color: rgba(122, 26, 34, 0.75);
    border-color: rgba(244, 206, 132, 0.95);
    color: #fff7e2;
}

.touch-button--jump {
    width: 230px;
    height: 230px;
    font-size: 34px;
    letter-spacing: 2px;
    border-radius: 115px;
    background-color: rgba(60, 16, 22, 0.5);
}

.touch-button--jump:active {
    background-color: rgba(150, 32, 42, 0.8);
}

.touch-button--down {
    font-size: 26px;
    letter-spacing: 1px;
    background-color: rgba(24, 20, 30, 0.5);
}

.touch-button--down:active {
    background-color: rgba(70, 58, 92, 0.8);
}

.touch-button--attack {
    width: 200px;
    height: 200px;
    font-size: 30px;
    letter-spacing: 2px;
    border-radius: 100px;
    background-color: rgba(68, 40, 12, 0.5);
}

.touch-button--attack:active {
    background-color: rgba(186, 108, 30, 0.8);
}

.touch-button--dash {
    font-size: 30px;
    letter-spacing: 1px;
    background-color: rgba(16, 30, 38, 0.5);
}

.touch-button--dash:active {
    background-color: rgba(38, 104, 128, 0.8);
}

.touch-button--fireball {
    width: 200px;
    height: 200px;
    font-size: 30px;
    letter-spacing: 2px;
    border-radius: 100px;
    background-color: rgba(74, 22, 14, 0.5);
}

.touch-button--fireball:active {
    background-color: rgba(196, 66, 26, 0.85);
}

/* Con 7 botones el margen por defecto deja los clusters muy juntos. */
.touch-controls-inner {
    padding: 0 48px 56px 48px;
}
