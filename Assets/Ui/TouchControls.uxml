<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="TouchControls.uss" />

    <!-- touch-only: TouchOnlyUI lo oculta cuando hay un mando activo. -->
    <ui:VisualElement name="touchControls" class="touch-controls touch-only" picking-mode="Ignore">

        <!-- TouchControlsController oculta esta capa mientras el juego está en pausa. -->
        <ui:VisualElement name="touchControlsInner" class="touch-controls-inner" picking-mode="Ignore">

            <!-- Controles por gestos (Opciones ▸ Interfaz): sustituye a movePad y actionPad. La superficie va
                 primero para quedar DEBAJO de los botones: lo que no pisa un botón es un gesto (TouchGestureInput). -->
            <ui:VisualElement name="gestureLayout" class="gesture-layout" picking-mode="Ignore">
                <ui:VisualElement name="gestureSurface" class="gesture-surface" />
                <ui:VisualElement name="gestureZone" class="gesture-zone" picking-mode="Ignore" />
                <ui:VisualElement name="gestureStick" class="gesture-stick" picking-mode="Ignore" />
                <ui:VisualElement name="gestureKnob" class="gesture-knob" picking-mode="Ignore" />
                <ui:VisualElement name="gestureAim" class="gesture-aim" picking-mode="Ignore" />
                <!-- Encima del salto, donde en el esquema clásico sale USAR (que con gestos se aparta a la izquierda). -->
                <ui:Button name="gestureParryButton" text="#touch.parry" class="touch-button touch-button--parry gesture-parry" />
                <ui:VisualElement name="gestureActions" class="gesture-actions" picking-mode="Ignore">
                    <ui:Button name="gestureAttackButton" text="#touch.attack" class="touch-button touch-button--attack" />
                    <ui:Button name="gestureDashButton" text="#touch.dash" class="touch-button touch-button--dash" />
                    <ui:Button name="gestureJumpButton" text="#touch.jump" class="touch-button touch-button--jump" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="movePad" class="touch-cluster touch-cluster--left" picking-mode="Ignore">
                <ui:Button name="leftButton" text="&lt;" class="touch-button" />
                <ui:Button name="rightButton" text="&gt;" class="touch-button" />
                <ui:Button name="downButton" text="#touch.down" class="touch-button touch-button--down" />
                <ui:Button name="dashButton" text="#touch.dash" class="touch-button touch-button--dash" />
            </ui:VisualElement>

            <!-- Sólo aparece con algo con lo que interactuar a mano (tienda, item del suelo, interactuables del hub). -->
            <ui:Button name="interactButton" text="#touch.interact" class="touch-button touch-button--interact" />

            <ui:VisualElement name="actionPad" class="touch-cluster touch-cluster--right" picking-mode="Ignore">
                <ui:Button name="parryButton" text="#touch.parry" class="touch-button touch-button--parry" />
                <ui:Button name="weaponButton" text="#touch.weapon" class="touch-button touch-button--fireball" />
                <ui:Button name="attackButton" text="#touch.attack" class="touch-button touch-button--attack" />
                <ui:Button name="jumpButton" text="#touch.jump" class="touch-button touch-button--jump" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
